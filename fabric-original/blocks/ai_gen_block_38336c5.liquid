    {
      "type": "header",
      "content": "Input fields"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Text color",
      "default": "#030302"
    },
    {
      "type": "color",
      "id": "input_border_color",
