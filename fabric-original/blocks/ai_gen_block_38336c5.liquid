{% doc %}
  @prompt
    It'd like to add a block that is an email sign up that ocnnects to our mailchimp. want an input for 'name' and 'email' and a button in our red color that says "email me the free pattern!"
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-mailchimp-signup-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-mailchimp-signup__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-mailchimp-signup__heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-mailchimp-signup__form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-mailchimp-signup__input-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background }};
    color: {{ block.settings.input_text_color }};
    font-size: 14px;
  }

  .ai-mailchimp-signup__input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_text_color }};
    opacity: 0.6;
  }

  .ai-mailchimp-signup__input-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.button_color }};
    outline-offset: 2px;
  }

  .ai-mailchimp-signup__button-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-mailchimp-signup__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-mailchimp-signup__message-{{ ai_gen_id }} {
    padding: 12px;
    border-radius: 4px;
    font-size: 14px;
    display: none;
  }

  .ai-mailchimp-signup__message-{{ ai_gen_id }}.success {
    display: block;
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .ai-mailchimp-signup__message-{{ ai_gen_id }}.error {
    display: block;
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  @media screen and (max-width: 749px) {
    .ai-mailchimp-signup-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<mailchimp-signup-{{ ai_gen_id }}
  class="ai-mailchimp-signup-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-mailchimp-signup__content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-mailchimp-signup__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <form
      action="{{ block.settings.mailchimp_action_url }}"
      method="post"
      class="ai-mailchimp-signup__form-{{ ai_gen_id }}"
      target="_blank"
      novalidate
    >
      <input
        type="text"
        name="NAME"
        class="ai-mailchimp-signup__input-{{ ai_gen_id }}"
        placeholder="{{ block.settings.name_placeholder }}"
        required
      >

      <input
        type="email"
        name="EMAIL"
        class="ai-mailchimp-signup__input-{{ ai_gen_id }}"
        placeholder="{{ block.settings.email_placeholder }}"
        required
      >

      <div style="position: absolute; left: -5000px;" aria-hidden="true">
        <input
          type="text"
          name="{{ block.settings.mailchimp_bot_field }}"
          tabindex="-1"
          value=""
        >
      </div>

      <button
        type="submit"
        class="ai-mailchimp-signup__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </button>
    </form>

    <div class="ai-mailchimp-signup__message-{{ ai_gen_id }}"></div>
  </div>
</mailchimp-signup-{{ ai_gen_id }}>

<script>
  (function() {
    class MailchimpSignup{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('.ai-mailchimp-signup__form-{{ ai_gen_id }}');
        this.message = this.querySelector('.ai-mailchimp-signup__message-{{ ai_gen_id }}');
        
        if (this.form) {
          this.form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        const nameInput = this.form.querySelector('input[name="NAME"]');
        const emailInput = this.form.querySelector('input[name="EMAIL"]');

        if (!nameInput.value.trim()) {
          event.preventDefault();
          this.showMessage('Please enter your name.', 'error');
          return;
        }

        if (!emailInput.value.trim() || !this.isValidEmail(emailInput.value)) {
          event.preventDefault();
          this.showMessage('Please enter a valid email address.', 'error');
          return;
        }

        this.showMessage('Redirecting to Mailchimp...', 'success');
      }

      isValidEmail(email) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        return emailRegex.test(email);
      }

      showMessage(text, type) {
        this.message.textContent = text;
        this.message.className = 'ai-mailchimp-signup__message-{{ ai_gen_id }} ' + type;
        
        if (type === 'error') {
          setTimeout(() => {
            this.message.className = 'ai-mailchimp-signup__message-{{ ai_gen_id }}';
          }, 5000);
        }
      }
    }

    customElements.define('mailchimp-signup-{{ ai_gen_id }}', MailchimpSignup{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Mailchimp email signup",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Mailchimp settings"
    },
    {
