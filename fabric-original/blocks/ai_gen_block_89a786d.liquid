{% doc %}
  @prompt
    Create a collection list section for the Collections page that displays collection cards in a 3-column grid layout. Each card should be a manually selectable collection block (not auto-populated), so the merchant can choose exactly which collection appears in each position and reorder them via drag-and-drop in the theme editor. Each block should have a setting to pick a specific collection, and display the collection image, title, and a link. Style should be clean and minimal with dark charcoal tones to match a premium brand aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-card-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-collection-card-container-{{ ai_gen_id }} {
    position: relative;
    display: block;
    text-decoration: none;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.card_background }};
    transition: transform 0.3s ease;
  }

  .ai-collection-card-container-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-collection-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-collection-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5efe5;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-collection-card-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: 400;
    line-height: 1.3;
  }

  .ai-collection-card-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    text-align: center;
    pointer-events: none;
  }
{% endstyle %}

<div class="ai-collection-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.collection != blank %}
    <a
      href="{{ block.settings.collection.url }}"
      class="ai-collection-card-container-{{ ai_gen_id }}"
    >
      <div class="ai-collection-card-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.collection.image %}
          <img
            src="{{ block.settings.collection.image | image_url: width: 800 }}"
            alt="{{ block.settings.collection.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.collection.image.width }}"
            height="{{ block.settings.collection.image.height }}"
            class="ai-collection-card-image-{{ ai_gen_id }}"
          >
        {% elsif block.settings.collection.products.first.featured_image %}
          <img
            src="{{ block.settings.collection.products.first.featured_image | image_url: width: 800 }}"
            alt="{{ block.settings.collection.products.first.featured_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.collection.products.first.featured_image.width }}"
            height="{{ block.settings.collection.products.first.featured_image.height }}"
            class="ai-collection-card-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
            {{ 'collection-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if block.settings.show_title %}
        <div class="ai-collection-card-content-{{ ai_gen_id }}">
          <h3 class="ai-collection-card-title-{{ ai_gen_id }}">
            {{ block.settings.collection.title }}
          </h3>
        </div>
      {% endif %}
    </a>
  {% else %}
    <div class="ai-collection-card-container-{{ ai_gen_id }}">
      <div class="ai-collection-card-image-wrapper-{{ ai_gen_id }}">
        <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
          {{ 'collection-1' | placeholder_svg_tag }}
        </div>
        <div class="ai-collection-card-empty-state-{{ ai_gen_id }}">
          Select a collection
        </div>
      </div>

      {% if block.settings.show_title %}
        <div class="ai-collection-card-content-{{ ai_gen_id }}">
          <h3 class="ai-collection-card-title-{{ ai_gen_id }}">
            Collection name
          </h3>
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection card",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show title",
      "default": true
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#030302"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#f5efe5"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "range",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "100% = square, 75% = landscape, 125% = portrait"
    }
  ],
  "presets": [
    {
      "name": "Collection card"
    }
  ]
}
{% endschema %}
