{% doc %}
  @prompt
    Create a product page block that automatically reads the product metafield with namespace "custom" and key "youtube_video" using product.metafields.custom.youtube_video in Liquid — do NOT use a block setting or source picker for the URL. Extract the YouTube video ID from the stored URL (supporting both youtube.com/watch?v= and youtu.be/ formats) and render a responsive 16:9 iframe embed with allowfullscreen. Show nothing if the metafield is empty or not set.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign youtube_url = product.metafields.custom.youtube_video
  assign video_id = ''

  if youtube_url != blank
    if youtube_url contains 'youtube.com/watch?v='
      assign video_id = youtube_url | split: 'v=' | last | split: '&' | first
    elsif youtube_url contains 'youtu.be/'
      assign video_id = youtube_url | split: 'youtu.be/' | last | split: '?' | first
    endif
  endif
%}

{% if video_id != blank %}
  {% style %}
    .ai-youtube-embed-{{ ai_gen_id }} {
      display: block;
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
      margin: 0 auto;
    }

    .ai-youtube-embed__wrapper-{{ ai_gen_id }} {
      position: relative;
      width: 100%;
      padding-bottom: 56.25%;
      height: 0;
      overflow: hidden;
      border-radius: {{ block.settings.border_radius }}px;
    }

    .ai-youtube-embed__iframe-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
  {% endstyle %}

  <div class="ai-youtube-embed-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-youtube-embed__wrapper-{{ ai_gen_id }}">
      <iframe
        class="ai-youtube-embed__iframe-{{ ai_gen_id }}"
        src="https://www.youtube.com/embed/{{ video_id }}"
        title="YouTube video player"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "YouTube video embed",
  "settings": [
    {
      "type": "paragraph",
      "content": "This block reads the product metafield custom.youtube_video and embeds the YouTube video. Add a YouTube URL to the product metafield to display the video."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "YouTube video embed"
    }
  ]
}
{% endschema %}
