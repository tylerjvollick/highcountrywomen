{% doc %}
  @prompt
    Create a product page block that embeds a YouTube video. The block should have a single text setting where a YouTube URL can be entered directly in the theme editor per product (using Shopify's per-product content/metafield source picker). Render the video as a responsive 16:9 iframe embed. Show nothing if no URL is entered.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if block.settings.youtube_url != blank %}
  {% assign video_id = '' %}
  
  {% if block.settings.youtube_url contains 'youtu.be/' %}
    {% assign video_id = block.settings.youtube_url | split: 'youtu.be/' | last | split: '?' | first %}
  {% elsif block.settings.youtube_url contains 'youtube.com/watch?v=' %}
    {% assign video_id = block.settings.youtube_url | split: 'v=' | last | split: '&' | first %}
  {% elsif block.settings.youtube_url contains 'youtube.com/embed/' %}
    {% assign video_id = block.settings.youtube_url | split: 'embed/' | last | split: '?' | first %}
  {% endif %}

  {% if video_id != blank %}
    {% style %}
      .ai-youtube-embed-{{ ai_gen_id }} {
        display: block;
        width: {{ block.settings.desktop_width_percent }}%;
        max-width: 100%;
        margin: 0 auto;
      }

      .ai-youtube-embed__wrapper-{{ ai_gen_id }} {
        position: relative;
        width: 100%;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        border-radius: {{ block.settings.border_radius }}px;
      }

      .ai-youtube-embed__iframe-{{ ai_gen_id }} {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }
    {% endstyle %}

    <div class="ai-youtube-embed-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
      <div class="ai-youtube-embed__wrapper-{{ ai_gen_id }}">
        <iframe
          class="ai-youtube-embed__iframe-{{ ai_gen_id }}"
          src="https://www.youtube.com/embed/{{ video_id }}"
          title="YouTube video player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "YouTube video",
  "settings": [
    {
      "type": "text",
      "id": "youtube_url",
      "label": "YouTube URL",
      "info": "Paste any YouTube video URL (e.g., https://www.youtube.com/watch?v=VIDEO_ID)"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 16,
      "step": 2,
      "unit": "px",
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "YouTube video"
    }
  ]
}
{% endschema %}