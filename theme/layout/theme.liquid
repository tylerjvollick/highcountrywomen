<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% comment %}
      Body sans: Hanken Grotesk from Google Fonts (variable weight 300–700).
      Brand display fonts (Goudy Old Style, Lora, Amsterdam One) are self-hosted
      and declared via @font-face in tokens.css.
    {% endcomment %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300..700&display=swap"
    >

    {% # Reset, OS 2.0 section grid, base resets %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% # Design tokens — color schemes, type, spacing, brand fonts %}
    {{ 'tokens.css' | asset_url | stylesheet_tag: preload: true }}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="color-cream">
    {% sections 'header-group' %}

    <main id="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}
  </body>
</html>
