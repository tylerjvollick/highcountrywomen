<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300..700&display=swap"
    >

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'tokens.css' | asset_url | stylesheet_tag: preload: true }}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="color-cream">
    {{ content_for_layout }}
  </body>
</html>
