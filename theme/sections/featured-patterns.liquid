{%- liquid
  assign coll = section.settings.collection
  assign count = section.settings.products_to_show
-%}

<section class="featured-patterns color-{{ section.settings.color_scheme }} full-width">
  <div class="featured-patterns__wrap">
    <div class="featured-patterns__header">
      <div class="featured-patterns__lead">
        {%- if section.settings.eyebrow != blank -%}
          <span class="featured-patterns__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="featured-patterns__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.show_view_all and section.settings.view_all_label != blank -%}
        {%- assign view_all_url = coll.url | default: section.settings.view_all_url -%}
        {%- if view_all_url != blank -%}
          <a class="featured-patterns__view-all" href="{{ view_all_url }}">
            {{ section.settings.view_all_label }}
          </a>
        {%- endif -%}
      {%- endif -%}
    </div>

    <div class="featured-patterns__grid">
      {%- for product in coll.products limit: count -%}
        <article class="pattern-card">
          <a class="pattern-card__media" href="{{ product.url }}" aria-label="{{ product.title }}">
            {%- if product.featured_image -%}
              {{ product.featured_image | image_url: width: 600 | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 860px) 25vw, 50vw',
                  widths: '300, 450, 600, 900',
                  class: 'pattern-card__img'
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'pattern-card__img pattern-card__img--placeholder' }}
            {%- endif -%}

            {%- if product.tags contains 'featured' -%}
              <span class="pattern-card__tag">Featured</span>
            {%- elsif product.compare_at_price > product.price -%}
              <span class="pattern-card__tag">Sale</span>
            {%- endif -%}
          </a>

          <div class="pattern-card__title-row">
            <a class="pattern-card__title" href="{{ product.url }}">{{ product.title }}</a>
            <span class="pattern-card__price">{{ product.price | money }}</span>
          </div>

          {%- assign type_label = product.type | default: 'PDF Pattern' -%}
          {%- assign difficulty = product.metafields.custom.pattern_difficulty_short -%}
          <p class="pattern-card__meta">
            {%- if difficulty != blank -%}
              {{ difficulty }} · {{ type_label }}
            {%- else -%}
              {{ type_label }}
            {%- endif -%}
          </p>

          <a class="pattern-card__cta ulink" href="{{ product.url }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
            View pattern
          </a>
        </article>
      {%- else -%}
        {%- for i in (1..count) -%}
          <article class="pattern-card pattern-card--placeholder">
            <div class="pattern-card__media">
              {{ 'product-1' | placeholder_svg_tag: 'pattern-card__img pattern-card__img--placeholder' }}
            </div>
            <div class="pattern-card__title-row">
              <span class="pattern-card__title">Pattern title</span>
              <span class="pattern-card__price">$0.00</span>
            </div>
            <p class="pattern-card__meta">PDF Pattern</p>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .featured-patterns {
    background: var(--bg);
    color: var(--text);
    padding-block: clamp(56px, 9vw, 132px);
    width: 100%;
  }

  .featured-patterns__wrap {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  /* Header row */
  .featured-patterns__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .featured-patterns__lead {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .featured-patterns__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .featured-patterns__eyebrow::before {
    content: "";
    width: 26px;
    height: 0;
    border-top: 1.5px solid currentColor;
    opacity: 0.8;
  }

  .featured-patterns__heading {
    margin: 0;
    font-size: clamp(2rem, 1.5rem + 1.6vw, 3.1rem);
  }

  .featured-patterns__view-all {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    position: relative;
    padding-bottom: 2px;
  }
  .featured-patterns__view-all::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }
  .featured-patterns__view-all:hover::after {
    transform: scaleX(1);
  }

  /* Grid */
  .featured-patterns__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(18px, 2.5vw, 30px);
  }

  /* Pattern card */
  .pattern-card {
    font-family: var(--font-sans);
    display: flex;
    flex-direction: column;
  }

  .pattern-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .pattern-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .pattern-card__media:hover .pattern-card__img {
    transform: scale(1.04);
  }
  .pattern-card__img--placeholder {
    opacity: 0.5;
  }

  .pattern-card__tag {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: var(--hcw-ink);
    color: var(--hcw-cream);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
  }

  .pattern-card__title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    margin-top: 15px;
  }

  .pattern-card__title {
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.15;
    color: var(--text);
    text-decoration: none;
  }
  .pattern-card__title:hover {
    color: var(--accent);
  }

  .pattern-card__price {
    font-size: 14px;
    color: var(--text-soft);
    white-space: nowrap;
  }

  .pattern-card__meta {
    margin: 3px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 13.5px;
    color: var(--text-mute);
  }

  .pattern-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 11px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    align-self: flex-start;
    position: relative;
    padding-bottom: 2px;
  }
  .pattern-card__cta svg {
    width: 14px;
    height: 14px;
  }
  .pattern-card__cta::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }
  .pattern-card__cta:hover::after {
    transform: scaleX(1);
  }

  @media (max-width: 860px) {
    .featured-patterns__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured patterns",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Pattern Library"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop our sewing patterns"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "View all link"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"view all\" link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link label",
      "default": "View all patterns"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Link URL override",
      "info": "When blank, links to the chosen collection."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "wheat"
    }
  ],
  "presets": [
    {
      "name": "Featured patterns",
      "settings": {
        "color_scheme": "wheat"
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
