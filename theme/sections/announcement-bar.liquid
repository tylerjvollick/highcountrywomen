{%- liquid
  assign text = section.settings.text | strip
  assign link = section.settings.link
-%}

{%- if text != blank -%}
  <div class="announcement-bar color-{{ section.settings.color_scheme }} full-width">
    <div class="announcement-bar__inner">
      {%- if link != blank -%}
        <a class="announcement-bar__text" href="{{ link }}">{{ text }}</a>
      {%- else -%}
        <span class="announcement-bar__text">{{ text }}</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement-bar {
    background: var(--bg);
    color: var(--text);
    width: 100%;
  }

  .announcement-bar__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: 8px var(--page-margin);
    text-align: center;
  }

  .announcement-bar__text {
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.4;
    color: inherit;
    text-decoration: none;
  }

  a.announcement-bar__text:hover {
    opacity: 0.78;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Message",
      "default": "Free pillow-cver pattern - perfect for the nervous beginner"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "terracotta"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "settings": {
        "color_scheme": "terracotta"
      }
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
