<section class="workshops-list color-{{ section.settings.color_scheme }} full-width">
  <div class="workshops-list__wrap">
    {%- if section.settings.lead != blank -%}
      <div class="workshops-list__lead">{{ section.settings.lead }}</div>
    {%- endif -%}

    <div class="workshops-list__items">
      {%- for block in section.blocks -%}
        {%- if block.type == 'class' -%}
          <article class="workshop-row" {{ block.shopify_attributes }}>
            <div class="workshop-row__date">{{ block.settings.date }}</div>

            <div class="workshop-row__body">
              {%- if block.settings.heading != blank -%}
                <h3 class="workshop-row__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.detail != blank -%}
                <div class="workshop-row__detail">{{ block.settings.detail }}</div>
              {%- endif -%}
              {%- if block.settings.level != blank -%}
                <span class="workshop-row__level">{{ block.settings.level }}</span>
              {%- endif -%}
            </div>

            <div class="workshop-row__actions">
              {%- if block.settings.price != blank -%}
                <span class="workshop-row__price">{{ block.settings.price }}</span>
              {%- endif -%}
              {%- if block.settings.cta_url != blank -%}
                <a class="workshop-row__cta" href="{{ block.settings.cta_url }}">
                  {{ block.settings.cta_label | default: 'Reserve a spot' }}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .workshops-list {
    background: var(--bg);
    color: var(--text);
    width: 100%;
    padding-block: clamp(56px, 9vw, 132px);
  }
  .workshops-list__wrap {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .workshops-list__lead {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-soft);
    max-width: 54ch;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .workshops-list__lead > p {
    margin: 0 0 0.5em;
    max-width: none;
  }
  .workshops-list__lead > p:last-child {
    margin-bottom: 0;
  }

  .workshops-list__items {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--line);
  }

  .workshop-row {
    display: grid;
    grid-template-columns: 160px 1fr auto;
    gap: clamp(16px, 3vw, 40px);
    align-items: center;
    padding: clamp(22px, 3vw, 34px) 0;
    border-top: 1px solid var(--line);
  }

  .workshop-row__date {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--accent);
  }

  .workshop-row__heading {
    margin: 0;
    font-size: var(--step-2);
    line-height: 1.15;
  }
  .workshop-row__detail {
    margin-top: 8px;
    font-family: var(--font-sans);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-soft);
    max-width: 52ch;
  }
  .workshop-row__detail > p {
    margin: 0 0 0.4em;
    max-width: none;
  }
  .workshop-row__detail > p:last-child {
    margin-bottom: 0;
  }
  .workshop-row__level {
    display: inline-block;
    margin-top: 10px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  .workshop-row__actions {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }
  .workshop-row__price {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 600;
    color: var(--text);
  }
  .workshop-row__cta {
    display: inline-flex;
    align-items: center;
    padding: 12px 22px;
    background: var(--accent);
    color: var(--accent-text);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background var(--dur) var(--ease);
    white-space: nowrap;
  }
  .workshop-row__cta:hover {
    background: var(--hcw-red-deep);
  }

  @media (max-width: 720px) {
    .workshop-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .workshop-row__actions {
      align-items: flex-start;
      text-align: left;
      flex-direction: row;
      justify-content: space-between;
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Workshops list",
  "max_blocks": 24,
  "settings": [
    {
      "type": "richtext",
      "id": "lead",
      "label": "Lead paragraph"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "class",
      "name": "Class",
      "settings": [
        {
          "type": "text",
          "id": "date",
          "label": "Date / day",
          "info": "e.g. \"Sat · Jun 14\""
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Class name"
        },
        {
          "type": "richtext",
          "id": "detail",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "level",
          "label": "Level"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "info": "Free-text so you can write \"$65\", \"$120 / 6 wk\", \"Sold out\", etc."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Reserve a spot"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Reserve link",
          "info": "Point at the individual workshop product page."
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
