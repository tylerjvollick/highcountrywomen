      "label": "Email field label",
      "default": "Email"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone field",
      "default": false
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone field label",
      "default": "Phone"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message field label",
      "default": "Message"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button label",
      "default": "Send us a note"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for reaching out — we'll get back to you within a few days."
    },
    {
      "type": "header",
      "content": "Other ways to reach us (sidebar)"
    },
    {
      "type": "text",
      "id": "info_eyebrow",
      "label": "Sidebar eyebrow",
      "default": "Or reach us at"
    },
    {
      "type": "richtext",
      "id": "info_heading",
      "label": "Sidebar heading"
    },
    {
      "type": "text",
      "id": "email_caption",
      "label": "Email caption",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address"
    },
    {
      "type": "text",
      "id": "location_caption",
      "label": "Location caption",
      "default": "Where we are"
    },
    {
      "type": "richtext",
      "id": "location",
      "label": "Location"
    },
    {
      "type": "text",
      "id": "hours_caption",
      "label": "Hours caption",
      "default": "Response time"
    },
    {
      "type": "richtext",
      "id": "hours",
      "label": "Hours"
    },
    {
      "type": "text",
      "id": "social_caption",
      "label": "Social caption",
      "default": "Follow along"
    },
    {
      "type": "richtext",
      "id": "social",
      "label": "Social"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "cream"
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "settings": {
        "color_scheme": "cream"
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
