{%- liquid
  assign ns = section.settings.metafield_namespace
  assign key = section.settings.metafield_key
  assign mf = product.metafields[ns][key]
  if mf != blank
    assign youtube_url = mf | append: ''
    assign embed_url = youtube_url | replace: 'watch?v=', 'embed/' | replace: 'youtu.be/', 'youtube.com/embed/'
  endif
-%}

{%- if embed_url != blank -%}
  <section class="sewalong color-{{ section.settings.color_scheme }} full-width">
    <div class="sewalong__wrap">
      {%- if section.settings.eyebrow != blank -%}
        <span class="sewalong__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="sewalong__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="sewalong__body">{{ section.settings.body }}</div>
      {%- endif -%}

      <div class="sewalong__player">
        <iframe
          class="sewalong__iframe"
          src="{{ embed_url }}"
          title="{{ product.title }} sewalong"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .sewalong {
    background: var(--bg);
    color: var(--text);
    width: 100%;
    padding-block: clamp(56px, 9vw, 132px);
  }
  .sewalong__wrap {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .sewalong__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .sewalong__eyebrow::before {
    content: "";
    width: 26px;
    height: 0;
    border-top: 1.5px solid currentColor;
    opacity: 0.8;
  }

  .sewalong__heading {
    margin: 16px 0 0;
    font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.6rem);
    line-height: 1.18;
    max-width: 20ch;
  }

  .sewalong__body {
    margin-top: 16px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-soft);
    max-width: 46ch;
  }
  .sewalong__body > p {
    margin: 0 0 0.5em;
    max-width: none;
  }
  .sewalong__body > p:last-child {
    margin-bottom: 0;
  }

  .sewalong__player {
    width: min(820px, 100%);
    margin-top: clamp(28px, 4vw, 40px);
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-md);
  }
  .sewalong__iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sewalong video",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Detailed sewalong tutorial"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow along, every step of the way"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>We walk you through the entire pattern in our detailed YouTube sewalong — perfect for beginners.</p>"
    },
    {
      "type": "header",
      "content": "Video source"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "info": "Looks for product.metafields.<namespace>.<key>. When the metafield is empty, the whole section is skipped — so it's safe to leave wired on every product.",
      "default": "youtube_url"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "wheat"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
