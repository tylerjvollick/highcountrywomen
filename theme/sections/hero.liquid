{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign image = section.settings.image
  assign badge_text = section.settings.badge_text | strip
-%}

<section class="hero-card color-{{ section.settings.color_scheme }} full-width">
  <div class="hero-card__wrap">
    <div class="hero-card__layout">
      <div class="hero-card__img">
        {%- if image != blank -%}
          {{ image | image_url: width: 1200 | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(min-width: 860px) 66vw, 100vw',
              widths: '480, 720, 960, 1200, 1600',
              class: 'hero-card__img-el'
          }}
        {%- else -%}
          <img
            class="hero-card__img-el"
            src="{{ 'DSCF1659.jpg' | asset_url }}"
            alt=""
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}

        {%- if badge_text != blank -%}
          {%- if section.settings.badge_url != blank -%}
            <a class="hero-card__badge hero-card__badge--link" href="{{ section.settings.badge_url }}">{{ badge_text }}</a>
          {%- else -%}
            <span class="hero-card__badge">{{ badge_text }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="hero-card__card">
        {%- if heading != blank -%}
          <h1 class="hero-card__heading">{{ heading }}</h1>
        {%- endif -%}

        <hr class="hero-card__rule" aria-hidden="true">

        {%- if subheading != blank -%}
          <p class="hero-card__subheading">{{ subheading }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="hero-card__links" role="list">
            {%- for block in section.blocks -%}
              {%- if block.settings.label != blank -%}
                <li class="hero-card__links-item" {{ block.shopify_attributes }}>
                  <a class="hero-card__link" href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .hero-card {
    background: var(--bg);
    color: var(--text);
    padding-block: clamp(24px, 3.5vw, 56px);
    width: 100%;
  }

  .hero-card__wrap {
    max-width: calc(var(--page-width) + 80px);
    margin-inline: auto;
    padding-inline: clamp(16px, 3vw, 32px);
  }

  .hero-card__layout {
    position: relative;
  }

  /* Image — right column on desktop, full width on mobile */
  .hero-card__img {
    position: relative;
    width: 66%;
    margin-left: auto;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--surface);
  }
  .hero-card__img-el {
    display: block;
    width: 100%;
    height: clamp(620px, 93vh, 880px);
    object-fit: cover;
    object-position: center 16%;
  }
  .hero-card__img-el--placeholder {
    height: clamp(420px, 60vh, 620px);
    object-fit: cover;
  }

  /* Sage corner badge */
  .hero-card__badge {
    position: absolute;
    top: clamp(16px, 1.6vw, 24px);
    right: clamp(16px, 1.6vw, 24px);
    background: var(--hcw-sage);
    color: #FBF8F1;
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 8px 14px;
  }
  a.hero-card__badge--link {
    text-decoration: none;
    transition: background var(--dur) var(--ease);
  }
  a.hero-card__badge--link:hover {
    background: #94966F;
  }

  /* Content card — left, overlaps image, vertically centered */
  .hero-card__card {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 40%;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
    padding: clamp(22px, 2vw, 32px);
  }

  .hero-card__heading {
    margin: 0;
    font-size: clamp(2.4rem, 2rem + 1.6vw, 3.6rem);
    line-height: 1.08;
  }
  /* Italic Lora highlight inside heading — merchant writes <em>word</em> */
  .hero-card__heading em {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--accent);
    font-weight: 400;
  }

  .hero-card__rule {
    border: 0;
    border-top: 2px solid var(--accent);
    width: 40px;
    margin: 14px 0;
  }

  .hero-card__subheading {
    font-family: var(--font-sans);
    font-size: clamp(0.88rem, 0.85rem + 0.12vw, 0.98rem);
    color: var(--text-soft);
    max-width: 30ch;
    margin: 0;
  }

  .hero-card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }
  .hero-card__links::before,
  .hero-card__links::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex: 0 0 auto;
  }
  .hero-card__link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .hero-card__link:hover {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .hero-card__layout {
      display: flex;
      flex-direction: column-reverse;
      gap: 16px;
    }
    .hero-card__img {
      width: 100%;
    }
    .hero-card__img-el {
      height: clamp(380px, 60vh, 560px);
    }
    .hero-card__card {
      position: static;
      transform: none;
      width: auto;
      margin: 0 14px;
    }
    .hero-card__links {
      justify-content: center;
    }
    .hero-card__links::before,
    .hero-card__links::after {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap a word in <em>…</em> for an italic accent (e.g. <em>heirloom</em>).",
      "default": "<p>sewing patterns & fabric for <em>heirloom</em> pieces.</p>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to make pieces worth keeping."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Corner badge",
      "info": "Optional editorial label on the image.",
      "default": "Heirloom Pieces · No. 01"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Corner badge link",
      "info": "Optional — makes the badge clickable."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Portrait orientation works best."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Patterns"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Hero",
      "settings": {
        "color_scheme": "cream"
      },
      "blocks": [
        { "type": "link", "settings": { "label": "Patterns" } },
        { "type": "link", "settings": { "label": "Fabric" } },
        { "type": "link", "settings": { "label": "Workshops" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
