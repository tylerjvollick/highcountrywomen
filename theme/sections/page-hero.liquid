{%- liquid
  assign image = section.settings.image
  assign focal_x = section.settings.focal_x | default: 50
  assign focal_y = section.settings.focal_y | default: 50
  assign heading = section.settings.heading
  if heading == blank and page != blank
    assign heading = page.title
  endif
-%}

<section
  class="page-hero full-width"
  style="--hero-min-height: clamp(340px, {{ section.settings.height_vw }}vw, {{ section.settings.height_max }}px); --focal-x: {{ focal_x }}%; --focal-y: {{ focal_y }}%;"
>
  <div class="page-hero__media">
    {%- if image != blank -%}
      {{ image | image_url: width: 2000 | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '720, 1080, 1440, 1800, 2400',
          class: 'page-hero__img'
      }}
    {%- else -%}
      <img
        class="page-hero__img"
        src="{{ 'DSCF2467.jpg' | asset_url }}"
        alt=""
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <div class="page-hero__scrim" aria-hidden="true"></div>

  <div class="page-hero__wrap">
    <div class="page-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="page-hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if heading != blank -%}
        <h1 class="page-hero__heading">{{ heading }}</h1>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="page-hero__body">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .page-hero {
    position: relative;
    width: 100%;
    min-height: var(--hero-min-height);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    color: #FBF8F1;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .page-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focal-x) var(--focal-y);
  }

  .page-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(46, 42, 36, 0.1) 0%, rgba(46, 42, 36, 0.5) 100%);
  }

  .page-hero__wrap {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding: clamp(80px, 12vw, 180px) var(--page-margin) clamp(36px, 5vw, 64px);
  }

  .page-hero__content {
    max-width: 740px;
  }

  .page-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--hcw-cream);
  }
  .page-hero__eyebrow::before {
    content: "";
    width: 26px;
    height: 0;
    border-top: 1.5px solid currentColor;
    opacity: 0.8;
  }

  .page-hero__heading {
    margin: 18px 0 0;
    font-size: clamp(2.6rem, 1.8rem + 4vw, 5rem);
    line-height: 1.02;
    color: #FBF8F1;
    text-shadow: 0 2px 30px rgba(40, 30, 20, 0.4);
  }

  .page-hero__body {
    margin-top: 22px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.5;
    color: rgba(245, 239, 229, 0.92);
    max-width: 54ch;
  }
  .page-hero__body > p {
    margin: 0 0 0.5em;
    max-width: none;
  }
  .page-hero__body > p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "When blank on a page template, falls back to the page title."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "height_vw",
      "label": "Height (viewport scaling)",
      "min": 30,
      "max": 70,
      "step": 2,
      "unit": "vw",
      "default": 52
    },
    {
      "type": "range",
      "id": "height_max",
      "label": "Max height",
      "min": 320,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 620
    },
    {
      "type": "range",
      "id": "focal_x",
      "label": "Focal point — horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focal_y",
      "label": "Focal point — vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    }
  ],
  "presets": [
    {
      "name": "Page hero"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
