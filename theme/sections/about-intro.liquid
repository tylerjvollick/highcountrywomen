{%- liquid
  assign eyebrow = section.settings.eyebrow | strip
  assign heading = section.settings.heading
  assign lead = section.settings.lead
  assign image = section.settings.image
  assign caption = section.settings.caption | strip
  assign greeting = section.settings.greeting | strip
  assign body = section.settings.body
  assign signoff = section.settings.signoff | strip
  assign signature = section.settings.signature | strip
-%}

<section class="about-intro color-{{ section.settings.color_scheme }} full-width">
  <div class="about-intro__wrap">
    <div class="about-intro__layout">
      <div class="about-intro__text">
        {%- if eyebrow != blank -%}
          <span class="about-intro__eyebrow">{{ eyebrow }}</span>
        {%- endif -%}

        {%- if heading != blank -%}
          <h1 class="about-intro__heading">{{ heading }}</h1>
        {%- endif -%}

        {%- if lead != blank -%}
          <div class="about-intro__lead lead">{{ lead }}</div>
        {%- endif -%}

        {%- if greeting != blank -%}
          <p class="about-intro__greeting lead">{{ greeting }}</p>
        {%- endif -%}

        {%- if body != blank -%}
          <div class="about-intro__body">{{ body }}</div>
        {%- endif -%}

        {%- if signoff != blank or signature != blank -%}
          <div class="about-intro__signoff">
            {%- if signoff != blank -%}
              <span class="about-intro__signoff-text">{{ signoff }}</span>
            {%- endif -%}
            {%- if signature != blank -%}
              <div class="about-intro__signature">{{ signature }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <figure class="about-intro__figure">
        {%- if image != blank -%}
          {{ image | image_url: width: 1200 | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 860px) 50vw, 100vw',
              widths: '480, 720, 960, 1200, 1600',
              class: 'about-intro__img'
          }}
        {%- else -%}
          <div class="about-intro__img about-intro__img--placeholder" aria-hidden="true"></div>
        {%- endif -%}

        {%- if caption != blank -%}
          <figcaption class="about-intro__caption">{{ caption }}</figcaption>
        {%- endif -%}
      </figure>
    </div>
  </div>
</section>

{% stylesheet %}
  .about-intro {
    background: var(--bg);
    color: var(--text);
    width: 100%;
  }
  .about-intro__wrap {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: clamp(48px, 7vw, 104px) var(--page-margin) clamp(48px, 6vw, 88px);
  }
  .about-intro__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .about-intro__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .about-intro__eyebrow::before {
    content: "";
    width: 26px;
    height: 0;
    border-top: 1.5px solid currentColor;
    opacity: 0.8;
  }

  .about-intro__heading {
    margin: 18px 0 0;
    font-size: clamp(2.4rem, 1.6rem + 3vw, 4rem);
    line-height: 1.08;
    max-width: 14ch;
  }
  .about-intro__heading em {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--accent);
    font-weight: 400;
  }

  .about-intro__lead {
    margin-top: 22px;
    max-width: 42ch;
  }
  .about-intro__lead > :first-child { margin-top: 0; }
  .about-intro__lead > :last-child  { margin-bottom: 0; }

  .about-intro__greeting {
    margin: clamp(36px, 5vw, 56px) 0 0;
    font-size: var(--step-2);
    color: var(--text);
  }

  .about-intro__body > p {
    margin-top: 18px;
    font-family: var(--font-sans);
    font-size: 16.5px;
    line-height: 1.78;
    color: var(--text-soft);
    text-wrap: pretty;
    max-width: 56ch;
  }
  .about-intro__body > p:first-child {
    margin-top: 20px;
  }

  .about-intro__signoff {
    margin-top: clamp(48px, 6vw, 72px);
  }
  .about-intro__signoff-text {
    display: block;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--text-soft);
  }
  .about-intro__signature {
    margin-top: clamp(20px, 2.4vw, 32px);
    font-family: var(--font-script);
    color: var(--accent);
    font-size: clamp(2.4rem, 1.8rem + 2.4vw, 3.6rem);
    line-height: 1;
  }

  /* Right column: image sticks to top of viewport (below the sticky header)
     until its grid cell — sized by the taller left column — scrolls past. */
  .about-intro__figure {
    margin: 0;
    position: sticky;
    top: clamp(88px, 11vh, 112px);
  }
  .about-intro__img {
    display: block;
    width: 100%;
    height: clamp(360px, 48vw, 560px);
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    background: var(--surface);
  }
  .about-intro__img--placeholder {
    background: var(--surface);
  }
  .about-intro__caption {
    margin-top: 12px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    color: var(--text-mute);
  }

  @media (max-width: 860px) {
    .about-intro__layout {
      grid-template-columns: 1fr;
      gap: clamp(28px, 6vw, 56px);
    }
    .about-intro__heading {
      max-width: none;
    }
    /* Image leads on mobile, with sticky disabled since it sits inline. */
    .about-intro__figure {
      position: static;
      top: auto;
      order: -1;
    }
    .about-intro__img {
      height: clamp(260px, 56vw, 420px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About intro",
  "settings": [
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap a word in <em>…</em> for an italic accent.",
      "default": "<p>Two friends, sewing in the high country.</p>"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "Lead paragraph",
      "default": "<p>We're Katie and Tobey — friends, neighbors, sewists, and the women behind High Country Women.</p>"
    },
    {
      "type": "header",
      "content": "Letter"
    },
    {
      "type": "text",
      "id": "greeting",
      "label": "Greeting",
      "default": "Hi there,"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Letter body",
      "default": "<p>Our story started in a small mountain town in Wyoming. In 2024, Tobey helped Katie plan her wedding after celebrating her own the year before — planning DIY weddings in rural Wyoming is not for the faint of heart! Our friendship took off, and before long we were planning regular sewing dates and dreaming up all the things we wanted to make.</p><p>At the time, we were both searching for what was next. Katie had recently been laid off, and Tobey was feeling stuck after spending several years trying to build a business that wasn't quite the right fit. We found ourselves dreaming about new possibilities — Katie dreamed of designing sewing patterns, and Tobey dreamed of opening a fabric shop.</p><p>One December evening during a quilt-coat sewing date, a lightbulb went off and we thought — \"what if we started something together?\" High Country Women was born a month later, in January of 2025. We also both found out we were pregnant with our first babies — at the same time.</p><p>In June 2025, we launched our first sewing pattern. In August, we launched our second. In September, our babies arrived just seven days apart.</p><p>Today, High Country Women has grown to include five sewing patterns, a small collection of fabrics, and our first in-person sewing workshop in the works. What began as two friends sewing together has become a business built around creativity, community, and a shared love of making things by hand.</p><p>We're excited to see where this journey takes us, and we're grateful you've chosen to be part of it.</p>"
    },
    {
      "type": "text",
      "id": "signoff",
      "label": "Sign-off",
      "default": "xoxo,"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "info": "Rendered in the Amsterdam One script.",
      "default": "Katie & Tobey"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founders photo",
      "info": "Portrait orientation works best — the image sticks alongside the letter body."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Katie & Tobey — Lander, Wyoming"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "cream"
    }
  ],
  "presets": [
    {
      "name": "About intro",
      "settings": {
        "color_scheme": "cream"
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
