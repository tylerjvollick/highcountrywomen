<section class="search-page color-{{ section.settings.color_scheme }} full-width">
  <div class="search-page__wrap">
    <header class="search-page__header">
      <span class="search-page__eyebrow">Search</span>
      <h1 class="search-page__heading">
        {%- if search.performed -%}
          Results for &ldquo;{{ search.terms | escape }}&rdquo;
        {%- else -%}
          What are you looking for?
        {%- endif -%}
      </h1>
    </header>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <label class="visually-hidden" for="SearchInput-{{ section.id }}">Search</label>
      <input
        id="SearchInput-{{ section.id }}"
        class="search-page__input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search patterns, fabric, workshops…"
      >
      <button type="submit" class="search-page__submit">Search</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p class="search-page__empty">
          No matches for &ldquo;{{ search.terms | escape }}&rdquo;. Try a simpler term, or browse the
          <a href="{{ routes.all_products_collection_url }}">full shop</a>.
        </p>
      {%- else -%}
        <p class="search-page__count">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}</p>

        {%- paginate search.results by 20 -%}
          <div class="search-page__grid">
            {%- for result in search.results -%}
              {%- if result.object_type == 'product' -%}
                <article class="pattern-card">
                  <a class="pattern-card__media" href="{{ result.url }}" aria-label="{{ result.title }}">
                    {%- if result.featured_image -%}
                      {{ result.featured_image | image_url: width: 600 | image_tag:
                          loading: 'lazy',
                          sizes: '(min-width: 860px) 25vw, 50vw',
                          widths: '300, 450, 600, 900',
                          class: 'pattern-card__img'
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'pattern-card__img pattern-card__img--placeholder' }}
                    {%- endif -%}
                  </a>
                  <div class="pattern-card__title-row">
                    <a class="pattern-card__title" href="{{ result.url }}">{{ result.title }}</a>
                    <span class="pattern-card__price">{{ result.price | money }}</span>
                  </div>
                  {%- assign type_label = result.type | default: 'PDF Pattern' -%}
                  {%- assign difficulty = result.metafields.custom.pattern_difficulty_short -%}
                  <p class="pattern-card__meta">
                    {%- if difficulty != blank -%}
                      {{ difficulty }} · {{ type_label }}
                    {%- else -%}
                      {{ type_label }}
                    {%- endif -%}
                  </p>
                </article>
              {%- else -%}
                <a class="search-result search-result--{{ result.object_type }}" href="{{ result.url }}">
                  <span class="search-result__type">{{ result.object_type | replace: '_', ' ' }}</span>
                  <h3 class="search-result__title">{{ result.title }}</h3>
                  {%- if result.summary != blank or result.excerpt != blank -%}
                    <p class="search-result__excerpt">{{ result.summary | default: result.excerpt | strip_html | truncatewords: 28 }}</p>
                  {%- endif -%}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="search-page__pagination" aria-label="Pagination">
              {{ paginate | default_pagination }}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .search-page {
    background: var(--bg);
    color: var(--text);
    width: 100%;
  }
  .search-page__wrap {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: clamp(40px, 6vw, 80px) var(--page-margin) clamp(56px, 8vw, 112px);
  }

  .search-page__header {
    text-align: center;
    margin-bottom: clamp(32px, 5vw, 48px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .search-page__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .search-page__eyebrow::before {
    content: "";
    width: 26px;
    height: 0;
    border-top: 1.5px solid currentColor;
    opacity: 0.8;
  }
  .search-page__heading {
    margin: 0;
    font-size: clamp(2rem, 1.5rem + 2vw, 3.2rem);
    line-height: 1.08;
    max-width: 22ch;
  }

  .search-page__form {
    display: flex;
    gap: 12px;
    margin: 0 auto clamp(32px, 4vw, 48px);
    max-width: 640px;
  }
  .search-page__input {
    flex: 1;
    padding: 14px 18px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 15px;
  }
  .search-page__input::placeholder {
    color: var(--text-mute);
  }
  .search-page__input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .search-page__submit {
    padding: 14px 22px;
    background: var(--accent);
    color: var(--accent-text);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .search-page__count {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-mute);
    margin: 0 0 22px;
  }
  .search-page__empty {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--text-mute);
    text-align: center;
    padding: 48px 0;
  }
  .search-page__empty a {
    color: var(--accent);
  }

  .search-page__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(18px, 2.5vw, 32px) clamp(18px, 2.5vw, 28px);
  }
  @media (max-width: 860px) {
    .search-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Non-product result card (article / page) */
  .search-result {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    padding: 22px 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur) var(--ease);
  }
  .search-result:hover {
    border-color: var(--accent);
  }
  .search-result__type {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .search-result__title {
    margin: 8px 0 0;
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--text);
  }
  .search-result__excerpt {
    margin: 8px 0 0;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-soft);
  }
  @media (max-width: 860px) {
    .search-result {
      grid-column: span 2;
    }
  }

  /* Pattern card (shared style — same as featured-patterns / collection) */
  .pattern-card {
    font-family: var(--font-sans);
    display: flex;
    flex-direction: column;
  }
  .pattern-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .pattern-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .pattern-card__media:hover .pattern-card__img {
    transform: scale(1.04);
  }
  .pattern-card__img--placeholder {
    opacity: 0.5;
  }
  .pattern-card__title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    margin-top: 15px;
  }
  .pattern-card__title {
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.15;
    color: var(--text);
    text-decoration: none;
  }
  .pattern-card__title:hover {
    color: var(--accent);
  }
  .pattern-card__price {
    font-size: 14px;
    color: var(--text-soft);
    white-space: nowrap;
  }
  .pattern-card__meta {
    margin: 3px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 13.5px;
    color: var(--text-mute);
  }

  /* Pagination (reuses cosmetic from collection-grid) */
  .search-page__pagination {
    margin-top: clamp(36px, 5vw, 60px);
    display: flex;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 14px;
  }
  .search-page__pagination .pagination {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .search-page__pagination a,
  .search-page__pagination .page.current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 10px;
    color: var(--text-soft);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .search-page__pagination a:hover {
    color: var(--accent);
    background: var(--surface);
  }
  .search-page__pagination .page.current {
    color: var(--accent-text);
    background: var(--accent);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "cream"
    }
  ],
  "enabled_on": {
    "templates": ["search"]
  }
}
{% endschema %}
