{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign type_label = product.type
  if type_label == blank
    assign type_label = section.settings.fallback_type_label
  endif
-%}

<section class="product color-{{ section.settings.color_scheme }} full-width">
  <div class="product__wrap">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="product__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="product__breadcrumb-sep">/</span>
        {%- if collection != blank -%}
          <a href="{{ collection.url }}">{{ collection.title }}</a>
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}">Shop</a>
        {%- endif -%}
        <span class="product__breadcrumb-sep">/</span>
        <span class="product__breadcrumb-current">{{ product.title }}</span>
      </nav>
    {%- endif -%}

    <div class="product__split">
      <div class="product__gallery">
        <div class="product__cover">
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 1200 | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                sizes: '(min-width: 860px) 52vw, 100vw',
                widths: '480, 720, 960, 1200, 1600',
                class: 'product__cover-img'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'product__cover-img product__cover-img--placeholder' }}
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product__thumbs" role="list">
            {%- for media in product.media -%}
              <button
                class="product__thumb {% if media == product.featured_media %}is-active{% endif %}"
                type="button"
                aria-label="Image {{ forloop.index }}"
              >
                {{ media | image_url: width: 200 | image_tag:
                    loading: 'lazy',
                    widths: '100, 150, 200',
                    sizes: '74px',
                    class: 'product__thumb-img'
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product__details">
        {%- if type_label != blank -%}
          <span class="product__eyebrow">{{ type_label }}</span>
        {%- endif -%}

        <h1 class="product__title">{{ product.title }}</h1>

        <div class="product__meta">
          <span class="product__price">{{ variant.price | money }}{% if variant.unit_price_measurement %} <span class="product__unit">{{ variant.unit_price | money }}{{ variant.unit_price_measurement.reference_value }}{{ variant.unit_price_measurement.reference_unit }}</span>{% endif %}</span>
          {%- if variant.compare_at_price > variant.price -%}
            <span class="product__compare-price">{{ variant.compare_at_price | money }}</span>
          {%- endif -%}
          {%- if section.settings.show_meta_secondary and product.vendor != blank -%}
            <span class="product__meta-secondary">· {{ product.vendor }}</span>
          {%- endif -%}
        </div>

        {%- if product.description != blank -%}
          <div class="product__description">{{ product.description }}</div>
        {%- endif -%}

        {%- form 'product', product, class: 'product__form' -%}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="product__option" name="{{ option.name }}">
                <legend class="product__option-legend">{{ option.name }}</legend>
                <div class="product__option-values">
                  {%- for value in option.values -%}
                    {%- assign option_index = forloop.parentloop.index0 -%}
                    {%- assign is_selected = false -%}
                    {%- if product.selected_or_first_available_variant.options[option_index] == value -%}
                      {%- assign is_selected = true -%}
                    {%- endif -%}
                    <label class="product__swatch {% if is_selected %}is-selected{% endif %}">
                      <input
                        type="radio"
                        name="options[{{ option.name | escape }}]"
                        value="{{ value | escape }}"
                        {% if is_selected %}checked{% endif %}
                      >
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}

            <noscript>
              <label class="product__option-legend" for="VariantSelect-{{ section.id }}">Variant</label>
              <select id="VariantSelect-{{ section.id }}" name="id" class="product__variant-select">
                {%- for v in product.variants -%}
                  <option value="{{ v.id }}" {% if v == variant %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>
                    {{ v.title }} — {{ v.price | money }}{% unless v.available %} (sold out){% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </noscript>
          {%- endunless -%}

          <input type="hidden" name="id" value="{{ variant.id }}">

          {%- if section.settings.show_quantity -%}
            <div class="product__quantity">
              <label for="Quantity-{{ section.id }}" class="product__option-legend">Quantity</label>
              <input
                id="Quantity-{{ section.id }}"
                class="product__quantity-input"
                type="number"
                name="quantity"
                value="1"
                min="1"
                step="1"
              >
            </div>
          {%- endif -%}

          <div class="product__buttons">
            <button
              type="submit"
              class="product__add-to-cart"
              {% unless variant.available %}disabled{% endunless %}
            >
              {%- if variant.available -%}
                {{ section.settings.button_label }} — {{ variant.price | money }}
              {%- else -%}
                Sold out
              {%- endif -%}
            </button>

            {%- if section.settings.show_dynamic_checkout -%}
              {{ form | payment_button }}
            {%- endif -%}
          </div>
        {%- endform -%}

        {%- if section.blocks.size > 0 -%}
          <div class="product__accordions">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'info_accordion' -%}
                  <details
                    class="product__accordion"
                    {% if block.settings.open_by_default %}open{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    <summary class="product__accordion-summary">
                      {{ block.settings.heading }}
                      <svg class="product__accordion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14"/>
                        <path class="product__accordion-icon-vert" d="M12 5v14"/>
                      </svg>
                    </summary>
                    <div class="product__accordion-body">{{ block.settings.content }}</div>
                  </details>
                {%- when 'metafield' -%}
                  {%- assign mf = product.metafields[block.settings.namespace][block.settings.key] -%}
                  {%- if mf != blank -%}
                    <details
                      class="product__accordion"
                      {% if block.settings.open_by_default %}open{% endif %}
                      {{ block.shopify_attributes }}
                    >
                      <summary class="product__accordion-summary">
                        {{ block.settings.heading }}
                        <svg class="product__accordion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M5 12h14"/>
                          <path class="product__accordion-icon-vert" d="M12 5v14"/>
                        </svg>
                      </summary>
                      <div class="product__accordion-body">{{ mf | metafield_tag }}</div>
                    </details>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.legal != blank -%}
          <div class="product__legal">{{ section.settings.legal }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .product {
    background: var(--bg);
    color: var(--text);
    width: 100%;
  }

  .product__wrap {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: 26px var(--page-margin) clamp(48px, 7vw, 96px);
  }

  /* Breadcrumb */
  .product__breadcrumb {
    font-family: var(--font-sans);
    font-size: 12.5px;
    color: var(--text-mute);
    letter-spacing: 0.02em;
    margin-bottom: clamp(26px, 3vw, 44px);
  }
  .product__breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .product__breadcrumb a:hover {
    color: var(--accent);
  }
  .product__breadcrumb-sep {
    margin: 0 8px;
    opacity: 0.6;
  }
  .product__breadcrumb-current {
    color: var(--text-soft);
  }

  /* Split layout */
  .product__split {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(28px, 4vw, 72px);
    align-items: flex-start;
  }

  /* Gallery */
  .product__gallery {
    position: sticky;
    top: 96px;
  }
  .product__cover {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .product__cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product__thumbs {
    display: flex;
    gap: 10px;
    margin-top: 14px;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .product__thumb {
    flex: 0 0 auto;
    width: 74px;
    height: 92px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--surface);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }
  .product__thumb.is-active {
    border-color: var(--text);
    border-width: 1.5px;
  }
  .product__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Details */
  .product__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .product__eyebrow::before {
    content: "";
    width: 26px;
    height: 0;
    border-top: 1.5px solid currentColor;
    opacity: 0.8;
  }

  .product__title {
    margin: 10px 0 0;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem);
    line-height: 1.08;
  }

  .product__meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 14px;
    flex-wrap: wrap;
  }
  .product__price {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 600;
    color: var(--text);
  }
  .product__unit {
    font-size: 13px;
    color: var(--text-mute);
    font-weight: 400;
  }
  .product__compare-price {
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--text-mute);
    text-decoration: line-through;
  }
  .product__meta-secondary {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-mute);
  }

  .product__description {
    margin-top: 24px;
    font-family: var(--font-sans);
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--text-soft);
    max-width: 54ch;
  }
  .product__description p {
    margin: 0 0 0.8em;
    max-width: none;
  }
  .product__description p:last-child {
    margin-bottom: 0;
  }

  /* Form */
  .product__form {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .product__option {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .product__option-legend {
    display: block;
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-soft);
    margin-bottom: 10px;
  }
  .product__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .product__swatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    background: transparent;
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 14px;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .product__swatch:hover {
    border-color: var(--text);
  }
  .product__swatch.is-selected {
    border-color: var(--text);
    border-width: 1.5px;
  }
  .product__swatch input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .product__swatch:has(input:checked) {
    border-color: var(--text);
    border-width: 1.5px;
  }

  .product__variant-select {
    width: 100%;
    padding: 12px 14px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 15px;
  }

  .product__quantity {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .product__quantity-input {
    width: 90px;
    padding: 10px 12px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 15px;
  }

  .product__buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .product__add-to-cart {
    padding: 16px 28px;
    background: var(--hcw-ink);
    color: var(--hcw-cream);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--dur) var(--ease);
  }
  .product__add-to-cart:hover {
    background: #000;
  }
  .product__add-to-cart:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  /* Style Shopify's payment_button (Buy it now / Apple Pay) */
  .shopify-payment-button__button {
    padding: 16px 28px !important;
    font-family: var(--font-sans) !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    border-radius: var(--radius-sm) !important;
  }

  /* Accordions */
  .product__accordions {
    margin-top: 34px;
  }
  .product__accordion {
    border-bottom: 1px solid var(--line);
  }
  .product__accordion-summary {
    list-style: none;
    cursor: pointer;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
  }
  .product__accordion-summary::-webkit-details-marker {
    display: none;
  }
  .product__accordion-icon {
    width: 18px;
    height: 18px;
    color: var(--text-soft);
  }
  .product__accordion[open] .product__accordion-icon-vert {
    display: none;
  }
  .product__accordion-body {
    padding: 0 0 22px;
    font-family: var(--font-sans);
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-soft);
  }
  .product__accordion-body > *:first-child {
    margin-top: 0;
  }
  .product__accordion-body > *:last-child {
    margin-bottom: 0;
  }

  /* Legal copy */
  .product__legal {
    margin-top: 28px;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-mute);
    max-width: 56ch;
  }
  .product__legal p {
    margin: 0 0 0.8em;
    max-width: none;
  }
  .product__legal p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 860px) {
    .product__split {
      grid-template-columns: 1fr;
    }
    .product__gallery {
      position: static;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "fallback_type_label",
      "label": "Fallback eyebrow label",
      "info": "Shown when product.type is empty. E.g. \"PDF Pattern\".",
      "default": "PDF Pattern"
    },
    {
      "type": "checkbox",
      "id": "show_meta_secondary",
      "label": "Show vendor next to price",
      "default": false
    },
    {
      "type": "header",
      "content": "Cart form"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button (Buy it now / Apple Pay)",
      "default": true
    },
    {
      "type": "header",
      "content": "Legal"
    },
    {
      "type": "richtext",
      "id": "legal",
      "label": "Fine print",
      "default": "<p>This listing is for a PDF pattern only, not a paper pattern or physical product. After your purchase has been finalized you will receive a link to zip folders containing your digital patterns.</p><p>Copyright © 2026 High Country Women. ALL RIGHTS RESERVED. Not for resale or profit.</p>"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "info_accordion",
      "name": "Info accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Section title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "metafield",
      "name": "Metafield accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Details"
        },
        {
          "type": "text",
          "id": "namespace",
          "label": "Metafield namespace",
          "default": "custom"
        },
        {
          "type": "text",
          "id": "key",
          "label": "Metafield key"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
