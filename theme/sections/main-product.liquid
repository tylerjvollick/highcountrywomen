{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign type_label = product.type
  if type_label == blank
    assign type_label = section.settings.fallback_type_label
  endif
-%}

<section class="product color-{{ section.settings.color_scheme }} full-width" data-product-section>
  <div class="product__wrap">
    {%- if section.settings.show_breadcrumb -%}
      {%- liquid
        assign crumb_collection = collection
        if crumb_collection == blank
          case product.template_suffix
            when 'sewing-patterns'
              assign crumb_collection = collections['sewingpatterns']
            when 'fabric'
              assign crumb_collection = collections['fabric']
            when 'workshops'
              assign crumb_collection = collections['workshops']
          endcase
        endif
      -%}
      <nav class="product__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="product__breadcrumb-sep">/</span>
        {%- if crumb_collection.title != blank -%}
          <a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a>
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}">Shop</a>
        {%- endif -%}
        <span class="product__breadcrumb-sep">/</span>
        <span class="product__breadcrumb-current">{{ product.title }}</span>
      </nav>
    {%- endif -%}

    <div class="product__split">
      <div class="product__gallery" data-product-gallery>
        <div class="product__cover">
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 1200 | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                sizes: '(min-width: 860px) 52vw, 100vw',
                widths: '480, 720, 960, 1200, 1600',
                class: 'product__cover-img',
                data-product-cover: ''
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'product__cover-img product__cover-img--placeholder' }}
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product__thumbs" role="list">
            {%- for media in product.media -%}
              <button
                class="product__thumb {% if media == product.featured_media %}is-active{% endif %}"
                type="button"
                aria-label="View image {{ forloop.index }}"
                data-product-thumb
                data-cover-src="{{ media | image_url: width: 1200 }}"
                data-cover-srcset="{{ media | image_url: width: 480 }} 480w, {{ media | image_url: width: 720 }} 720w, {{ media | image_url: width: 960 }} 960w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
              >
                {{ media | image_url: width: 200 | image_tag:
                    loading: 'lazy',
                    widths: '100, 150, 200',
                    sizes: '74px',
                    class: 'product__thumb-img'
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product__details">
        {%- if type_label != blank -%}
          <span class="product__eyebrow">{{ type_label }}</span>
        {%- endif -%}

        <h1 class="product__title">{{ product.title }}</h1>

        <div class="product__meta">
          <span class="product__price" data-variant-price>{{ variant.price | money }}{% if variant.unit_price_measurement %} <span class="product__unit">{{ variant.unit_price | money }}{{ variant.unit_price_measurement.reference_value }}{{ variant.unit_price_measurement.reference_unit }}</span>{% endif %}</span>
          <span class="product__compare-price" data-variant-compare-price {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>{{ variant.compare_at_price | money }}</span>
          {%- if section.settings.show_meta_secondary and product.vendor != blank -%}
            <span class="product__meta-secondary">· {{ product.vendor }}</span>
          {%- endif -%}
        </div>

        {%- if product.description != blank -%}
          <div class="product__description">{{ product.description }}</div>
        {%- endif -%}

        {%- form 'product', product, class: 'product__form' -%}
          {%- unless product.has_only_default_variant -%}
            <div data-product-options>
              {%- for option in product.options_with_values -%}
                <fieldset class="product__option" name="{{ option.name }}">
                  <legend class="product__option-legend">{{ option.name }}</legend>
                  <div class="product__option-values">
                    {%- for value in option.values -%}
                      {%- assign option_index = forloop.parentloop.index0 -%}
                      {%- assign is_selected = false -%}
                      {%- if product.selected_or_first_available_variant.options[option_index] == value -%}
                        {%- assign is_selected = true -%}
                      {%- endif -%}
                      <label class="product__swatch {% if is_selected %}is-selected{% endif %}">
                        <input
                          type="radio"
                          name="options[{{ option.name | escape }}]"
                          value="{{ value | escape }}"
                          {% if is_selected %}checked{% endif %}
                        >
                        <span>{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>

            <noscript>
              <label class="product__option-legend" for="VariantSelect-{{ section.id }}">Variant</label>
              <select id="VariantSelect-{{ section.id }}" name="id" class="product__variant-select">
                {%- for v in product.variants -%}
                  <option value="{{ v.id }}" {% if v == variant %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>
                    {{ v.title }} — {{ v.price | money }}{% unless v.available %} (sold out){% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </noscript>
          {%- endunless -%}

          <input type="hidden" name="id" value="{{ variant.id }}" data-variant-id-input>

          {%- if section.settings.show_quantity -%}
            <div class="product__quantity">
              <label for="Quantity-{{ section.id }}" class="product__option-legend">Quantity</label>
              <input
                id="Quantity-{{ section.id }}"
                class="product__quantity-input"
                type="number"
                name="quantity"
                value="1"
                min="1"
                step="1"
              >
            </div>
          {%- endif -%}

          <div class="product__buttons">
            <button
              type="submit"
              class="product__add-to-cart"
              data-add-to-cart
              data-button-label="{{ section.settings.button_label | escape }}"
              {% unless variant.available %}disabled{% endunless %}
            >
              <span data-add-to-cart-text>
                {%- if variant.available -%}
                  {{ section.settings.button_label }} — {{ variant.price | money }}
                {%- else -%}
                  Sold out
                {%- endif -%}
              </span>
            </button>

            {%- if section.settings.show_dynamic_checkout -%}
              {{ form | payment_button }}
            {%- endif -%}
          </div>
        {%- endform -%}

        {%- if section.blocks.size > 0 -%}
          <div class="product__accordions">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'info_accordion' -%}
                  <details
                    class="product__accordion"
                    {% if block.settings.open_by_default %}open{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    <summary class="product__accordion-summary">
                      {{ block.settings.heading }}
                      <svg class="product__accordion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14"/>
                        <path class="product__accordion-icon-vert" d="M12 5v14"/>
                      </svg>
                    </summary>
                    <div class="product__accordion-body">{{ block.settings.content }}</div>
                  </details>
                {%- when 'metafield' -%}
                  {%- assign mf = product.metafields[block.settings.namespace][block.settings.key] -%}
                  {%- if mf != blank -%}
                    <details
                      class="product__accordion"
                      {% if block.settings.open_by_default %}open{% endif %}
                      {{ block.shopify_attributes }}
                    >
                      <summary class="product__accordion-summary">
                        {{ block.settings.heading }}
                        <svg class="product__accordion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M5 12h14"/>
                          <path class="product__accordion-icon-vert" d="M12 5v14"/>
                        </svg>
                      </summary>
                      <div class="product__accordion-body">{{ mf | metafield_tag }}</div>
                    </details>
                  {%- endif -%}
                {%- when 'linked_metafield' -%}
                  {%- assign links_mf = product.metafields[block.settings.namespace][block.settings.key] -%}
                  {%- if links_mf.value.size > 0 -%}
                    <details
                      class="product__accordion"
                      {% if block.settings.open_by_default %}open{% endif %}
                      {{ block.shopify_attributes }}
                    >
                      <summary class="product__accordion-summary">
                        {{ block.settings.heading }}
                        <svg class="product__accordion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M5 12h14"/>
                          <path class="product__accordion-icon-vert" d="M12 5v14"/>
                        </svg>
                      </summary>
                      <div class="product__accordion-body">
                        <ul class="product__link-list">
                          {%- for link in links_mf.value -%}
                            {%- assign is_external = false -%}
                            {%- if link.url contains '://' -%}
                              {%- assign is_external = true -%}
                            {%- endif -%}
                            <li>
                              <a href="{{ link.url }}"{% if is_external %} target="_blank" rel="noopener"{% endif %}>
                                <span>{{ link.text | default: link.url }}</span>
                                {%- if is_external -%}
                                  <svg class="product__link-external" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M7 17 17 7"/>
                                    <path d="M7 7h10v10"/>
                                  </svg>
                                {%- endif -%}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    </details>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.legal != blank -%}
          <div class="product__legal">{{ section.settings.legal }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-variants>
  [
  {%- for v in product.variants -%}
  {%- unless forloop.first -%},{%- endunless -%}
  {%- liquid
    if v.featured_image
      assign v_src = v.featured_image | image_url: width: 1200
      assign v_src_480 = v.featured_image | image_url: width: 480
      assign v_src_720 = v.featured_image | image_url: width: 720
      assign v_src_960 = v.featured_image | image_url: width: 960
      assign v_src_1600 = v.featured_image | image_url: width: 1600
      capture v_srcset
        echo v_src_480
        echo ' 480w, '
        echo v_src_720
        echo ' 720w, '
        echo v_src_960
        echo ' 960w, '
        echo v_src
        echo ' 1200w, '
        echo v_src_1600
        echo ' 1600w'
      endcapture
    endif
  -%}
  {"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available }},"price":{{ v.price }},"price_formatted":{{ v.price | money | json }},"compare_at_price_formatted":{%- if v.compare_at_price > v.price -%}{{ v.compare_at_price | money | json }}{%- else -%}null{%- endif -%}{%- if v.featured_image -%},"image":{"src":{{ v_src | json }},"srcset":{{ v_srcset | json }}}{%- endif -%}}
  {%- endfor -%}
  ]
  </script>
</section>

{% stylesheet %}
  .product {
    background: var(--bg);
    color: var(--text);
    width: 100%;
  }

  .product__wrap {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: 26px var(--page-margin) clamp(48px, 7vw, 96px);
  }

  /* Breadcrumb */
  .product__breadcrumb {
    font-family: var(--font-sans);
    font-size: 12.5px;
    color: var(--text-mute);
    letter-spacing: 0.02em;
    margin-bottom: clamp(26px, 3vw, 44px);
  }
  .product__breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .product__breadcrumb a:hover {
    color: var(--accent);
  }
  .product__breadcrumb-sep {
    margin: 0 8px;
    opacity: 0.6;
  }
  .product__breadcrumb-current {
    color: var(--text-soft);
  }

  /* Split layout */
  .product__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 4vw, 72px);
    align-items: flex-start;
  }

  /* Gallery */
  .product__gallery {
    position: sticky;
    top: 96px;
    min-width: 0;
  }
  .product__details {
    min-width: 0;
  }
  .product__cover {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .product__cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product__thumbs {
    display: flex;
    gap: 10px;
    margin-top: 14px;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .product__thumb {
    flex: 0 0 auto;
    width: 74px;
    height: 74px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--surface);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }
  .product__thumb.is-active {
    border-color: var(--text);
    border-width: 1.5px;
  }
  .product__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Details */
  .product__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .product__eyebrow::before {
    content: "";
    width: 26px;
    height: 0;
    border-top: 1.5px solid currentColor;
    opacity: 0.8;
  }

  .product__title {
    margin: 10px 0 0;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem);
    line-height: 1.08;
  }

  .product__meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 14px;
    flex-wrap: wrap;
  }
  .product__price {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 600;
    color: var(--text);
  }
  .product__unit {
    font-size: 13px;
    color: var(--text-mute);
    font-weight: 400;
  }
  .product__compare-price {
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--text-mute);
    text-decoration: line-through;
  }
  .product__meta-secondary {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-mute);
  }

  .product__description {
    margin-top: 24px;
    font-family: var(--font-sans);
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--text-soft);
    max-width: 54ch;
  }
  .product__description p {
    margin: 0 0 0.8em;
    max-width: none;
  }
  .product__description p:last-child {
    margin-bottom: 0;
  }

  /* Form */
  .product__form {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  [data-product-options] {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .product__option {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .product__option-legend {
    display: block;
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-soft);
    margin-bottom: 10px;
  }
  .product__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .product__swatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    background: transparent;
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 14px;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .product__swatch:hover {
    border-color: var(--text);
  }
  .product__swatch.is-selected {
    border-color: var(--text);
    border-width: 1.5px;
  }
  .product__swatch input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .product__swatch:has(input:checked) {
    border-color: var(--text);
    border-width: 1.5px;
  }

  .product__variant-select {
    width: 100%;
    padding: 12px 14px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 15px;
  }

  .product__quantity {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .product__quantity-input {
    width: 90px;
    padding: 10px 12px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 15px;
  }

  .product__buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .product__add-to-cart {
    padding: 16px 28px;
    background: var(--hcw-ink);
    color: var(--hcw-cream);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--dur) var(--ease);
  }
  .product__add-to-cart:hover {
    background: #000;
  }
  .product__add-to-cart:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  /* Style Shopify's payment_button (Buy it now / Apple Pay) */
  .shopify-payment-button__button {
    padding: 16px 28px !important;
    font-family: var(--font-sans) !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    border-radius: var(--radius-sm) !important;
  }

  /* Accordions */
  .product__accordions {
    margin-top: 34px;
  }
  .product__accordion {
    border-bottom: 1px solid var(--line);
  }
  .product__accordion-summary {
    list-style: none;
    cursor: pointer;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
  }
  .product__accordion-summary::-webkit-details-marker {
    display: none;
  }
  .product__accordion-icon {
    width: 18px;
    height: 18px;
    color: var(--text-soft);
  }
  .product__accordion[open] .product__accordion-icon-vert {
    display: none;
  }
  .product__accordion-body {
    padding: 0 0 22px;
    font-family: var(--font-sans);
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-soft);
  }
  .product__accordion-body > *:first-child {
    margin-top: 0;
  }
  .product__accordion-body > *:last-child {
    margin-bottom: 0;
  }

  /* Link list inside an accordion (linked_metafield block) */
  .product__link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .product__link-list li + li {
    border-top: 1px solid var(--line);
  }
  .product__link-list a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 0;
    color: var(--text);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .product__link-list a:hover {
    color: var(--accent);
  }
  .product__link-list a span {
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease);
  }
  .product__link-list a:hover span {
    border-bottom-color: currentColor;
  }
  .product__link-external {
    width: 12px;
    height: 12px;
    flex: none;
    opacity: 0.6;
  }

  /* Legal copy */
  .product__legal {
    margin-top: 28px;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-mute);
    max-width: 56ch;
  }
  .product__legal p {
    margin: 0 0 0.8em;
    max-width: none;
  }
  .product__legal p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 860px) {
    .product__split {
      grid-template-columns: 1fr;
    }
    .product__gallery {
      position: static;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Thumbnail rail: click a thumb → swap the main cover image
  document.querySelectorAll('[data-product-gallery]').forEach((gallery) => {
    const cover = gallery.querySelector('[data-product-cover]');
    const thumbs = gallery.querySelectorAll('[data-product-thumb]');
    if (!cover || thumbs.length === 0) return;

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const src = thumb.dataset.coverSrc;
        const srcset = thumb.dataset.coverSrcset;
        if (!src) return;
        cover.src = src;
        if (srcset) cover.srcset = srcset;
        thumbs.forEach((t) => t.classList.remove('is-active'));
        thumb.classList.add('is-active');
      });
    });
  });

  // Variant picker: change a swatch → resolve matching variant, update id +
  // price + button + cover (when the variant carries its own featured_image)
  document.querySelectorAll('[data-product-section]').forEach((section) => {
    const optionsRoot = section.querySelector('[data-product-options]');
    const variantsScript = section.querySelector('[data-product-variants]');
    if (!optionsRoot || !variantsScript) return;

    let variants;
    try { variants = JSON.parse(variantsScript.textContent); } catch (e) { return; }
    if (!Array.isArray(variants)) return;

    const idInput = section.querySelector('[data-variant-id-input]');
    const priceEl = section.querySelector('[data-variant-price]');
    const compareEl = section.querySelector('[data-variant-compare-price]');
    const cover = section.querySelector('[data-product-cover]');
    const thumbs = section.querySelectorAll('[data-product-thumb]');
    const addBtn = section.querySelector('[data-add-to-cart]');
    const addBtnText = section.querySelector('[data-add-to-cart-text]');

    function selectedOptions() {
      return Array.from(optionsRoot.querySelectorAll('input[type="radio"]:checked'))
        .map((input) => input.value);
    }

    function findVariant() {
      const sel = selectedOptions();
      return variants.find((v) =>
        Array.isArray(v.options) &&
        v.options.length === sel.length &&
        v.options.every((opt, i) => opt === sel[i])
      );
    }

    function updateSwatchHighlight() {
      optionsRoot.querySelectorAll('.product__swatch').forEach((label) => {
        const input = label.querySelector('input[type="radio"]');
        label.classList.toggle('is-selected', !!input && input.checked);
      });
    }

    function syncCoverToThumbs(src) {
      thumbs.forEach((t) => {
        t.classList.toggle('is-active', t.dataset.coverSrc === src);
      });
    }

    function applyVariant(variant) {
      if (!variant) return;

      if (idInput) idInput.value = variant.id;

      if (priceEl) priceEl.textContent = variant.price_formatted;
      if (compareEl) {
        if (variant.compare_at_price_formatted) {
          compareEl.textContent = variant.compare_at_price_formatted;
          compareEl.hidden = false;
        } else {
          compareEl.hidden = true;
        }
      }

      if (addBtn) {
        addBtn.disabled = !variant.available;
      }
      if (addBtnText) {
        const label = addBtn ? addBtn.dataset.buttonLabel : 'Add to cart';
        addBtnText.textContent = variant.available
          ? label + ' — ' + variant.price_formatted
          : 'Sold out';
      }

      if (variant.image && cover) {
        cover.src = variant.image.src;
        if (variant.image.srcset) cover.srcset = variant.image.srcset;
        syncCoverToThumbs(variant.image.src);
      }
    }

    optionsRoot.addEventListener('change', (e) => {
      if (e.target && e.target.matches('input[type="radio"]')) {
        updateSwatchHighlight();
        applyVariant(findVariant());
      }
    });
  });
{% endjavascript %}

