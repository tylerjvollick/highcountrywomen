{%- liquid
  assign limit = section.settings.products_to_show
  assign rec_url = routes.product_recommendations_url
-%}

<section
  class="related-products color-{{ section.settings.color_scheme }} full-width"
  data-related-products
  data-url="{{ rec_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}"
>
  <div class="related-products__wrap">
    <div class="related-products__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="related-products__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.show_view_all -%}
        {%- assign view_all_url = section.settings.view_all_url -%}
        {%- if view_all_url == blank -%}
          {%- assign view_all_url = product.collections.first.url | default: routes.all_products_collection_url -%}
        {%- endif -%}
        <a class="related-products__view-all" href="{{ view_all_url }}">
          {{ section.settings.view_all_label }}
        </a>
      {%- endif -%}
    </div>

    {%- if recommendations.performed -%}
      {%- if recommendations.products_count > 0 -%}
        <div class="related-products__grid">
          {%- for product in recommendations.products -%}
            <article class="pattern-card">
              <a class="pattern-card__media" href="{{ product.url }}" aria-label="{{ product.title }}">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 600 | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 860px) 25vw, 50vw',
                      widths: '300, 450, 600, 900',
                      class: 'pattern-card__img'
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'pattern-card__img pattern-card__img--placeholder' }}
                {%- endif -%}

                {%- if product.tags contains 'featured' -%}
                  <span class="pattern-card__tag">Featured</span>
                {%- elsif product.compare_at_price > product.price -%}
                  <span class="pattern-card__tag">Sale</span>
                {%- endif -%}
              </a>

              <div class="pattern-card__title-row">
                <a class="pattern-card__title" href="{{ product.url }}">{{ product.title }}</a>
                <span class="pattern-card__price">{{ product.price | money }}</span>
              </div>

              {%- assign type_label = product.type | default: 'PDF Pattern' -%}
              {%- assign difficulty = product.metafields.custom.pattern_difficulty_short -%}
              <p class="pattern-card__meta">
                {%- if difficulty != blank -%}
                  {{ difficulty }} · {{ type_label }}
                {%- else -%}
                  {{ type_label }}
                {%- endif -%}
              </p>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      {%- comment -%}
        Initial server render: leave the grid empty. The data-url attribute is
        fetched client-side; the response includes recommendations.performed=true
        and we swap the section's inner HTML.
      {%- endcomment -%}
      <div class="related-products__grid related-products__grid--placeholder" aria-hidden="true">
        {%- for i in (1..limit) -%}
          <div class="pattern-card pattern-card--skeleton"></div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .related-products {
    background: var(--bg);
    color: var(--text);
    width: 100%;
    padding-block: clamp(56px, 9vw, 132px);
  }
  .related-products__wrap {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .related-products__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: clamp(24px, 3vw, 40px);
  }
  .related-products__heading {
    margin: 0;
    font-size: var(--step-3);
    line-height: 1.1;
  }
  .related-products__view-all {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    position: relative;
    padding-bottom: 2px;
  }
  .related-products__view-all::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }
  .related-products__view-all:hover::after {
    transform: scaleX(1);
  }

  .related-products__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(18px, 2.5vw, 28px);
  }
  @media (max-width: 860px) {
    .related-products__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Pattern card (shared style — same as featured-patterns / collection / search) */
  .related-products .pattern-card {
    font-family: var(--font-sans);
    display: flex;
    flex-direction: column;
  }
  .related-products .pattern-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .related-products .pattern-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .related-products .pattern-card__media:hover .pattern-card__img {
    transform: scale(1.04);
  }
  .related-products .pattern-card__img--placeholder {
    opacity: 0.5;
  }
  .related-products .pattern-card__tag {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: var(--hcw-ink);
    color: var(--hcw-cream);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
  }
  .related-products .pattern-card__title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    margin-top: 15px;
  }
  .related-products .pattern-card__title {
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.15;
    color: var(--text);
    text-decoration: none;
  }
  .related-products .pattern-card__title:hover {
    color: var(--accent);
  }
  .related-products .pattern-card__price {
    font-size: 14px;
    color: var(--text-soft);
    white-space: nowrap;
  }
  .related-products .pattern-card__meta {
    margin: 3px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 13.5px;
    color: var(--text-mute);
  }

  /* Skeleton placeholder (shown until the AJAX swap replaces it) */
  .pattern-card--skeleton {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-sm);
    background: var(--surface);
    opacity: 0.5;
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-related-products]').forEach((host) => {
    const url = host.dataset.url;
    if (!url) return;

    fetch(url)
      .then((res) => (res.ok ? res.text() : Promise.reject(res.status)))
      .then((html) => {
        const tmp = document.createElement('div');
        tmp.innerHTML = html.trim();
        const fetched = tmp.querySelector('[data-related-products]');
        if (!fetched) {
          host.hidden = true;
          return;
        }
        // If the recommendations response carries no products, hide the section.
        const grid = fetched.querySelector('.related-products__grid');
        if (!grid || grid.children.length === 0) {
          host.hidden = true;
          return;
        }
        host.innerHTML = fetched.innerHTML;
      })
      .catch(() => {
        host.hidden = true;
      });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "View all link"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"view all\" link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Link URL override",
      "info": "When blank, falls back to the product's first collection."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "cream"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
