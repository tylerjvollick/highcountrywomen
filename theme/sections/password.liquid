{% comment %}
  Password page — rendered while the storefront is password-protected.
  Layout: layout/password.liquid → templates/password.json → this section.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{%- liquid
  assign image = section.settings.image
  assign logo = section.settings.logo
  assign has_image = false
  if image != blank
    assign has_image = true
  endif
-%}

<section
  class="password-page color-{{ section.settings.color_scheme }} full-width password-page--image-{{ section.settings.image_position }}{% unless has_image %} password-page--no-image{% endunless %}"
>
  <div class="password-page__split">
    <div class="password-page__copy">
      <div class="password-page__inner">
        {%- if logo != blank -%}
          <a class="password-page__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
            {{ logo | image_url: width: 480 | image_tag:
                loading: 'eager',
                sizes: '200px',
                widths: '200, 320, 480',
                alt: shop.name,
                class: 'password-page__logo-img'
            }}
          </a>
        {%- else -%}
          <div class="password-page__wordmark wordmark">{{ shop.name }}</div>
        {%- endif -%}

        {%- if section.settings.eyebrow != blank -%}
          <span class="password-page__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <div class="password-page__heading">{{ section.settings.heading }}</div>
        {%- else -%}
          <h1 class="password-page__heading">{{ 'password.title' | t }}</h1>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="password-page__body">{{ section.settings.body }}</div>
        {%- elsif shop.password_message != blank -%}
          <div class="password-page__body">{{ shop.password_message }}</div>
        {%- endif -%}

        {%- form 'storefront_password', class: 'password-page__form' -%}
          <label class="visually-hidden" for="PasswordInput-{{ section.id }}">
            {{ 'password.password' | t }}
          </label>
          <input
            id="PasswordInput-{{ section.id }}"
            class="password-page__input"
            type="password"
            name="password"
            placeholder="{{ section.settings.placeholder | escape }}"
            autocomplete="current-password"
            {% if form.errors %}aria-invalid="true"{% endif %}
          >
          <button type="submit" class="password-page__submit">
            {{ section.settings.button_label }}
          </button>
          {%- if form.errors -%}
            <p class="password-page__error">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.show_newsletter -%}
          <div class="password-page__divider" aria-hidden="true"></div>
          <div class="password-page__newsletter">
            {%- if section.settings.newsletter_heading != blank -%}
              <div class="password-page__newsletter-heading">
                {{ section.settings.newsletter_heading }}
              </div>
            {%- endif -%}

            {%- form 'customer', class: 'password-page__newsletter-form' -%}
              {%- if form.posted_successfully? -%}
                <p class="password-page__newsletter-success">
                  {{ section.settings.newsletter_success }}
                </p>
              {%- else -%}
                <input
                  type="hidden"
                  name="contact[tags]"
                  value="newsletter,{{ section.settings.newsletter_tag | escape }}"
                >
                <label class="visually-hidden" for="PasswordPageEmail-{{ section.id }}">Email</label>
                <input
                  id="PasswordPageEmail-{{ section.id }}"
                  class="password-page__newsletter-input"
                  type="email"
                  name="contact[email]"
                  placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                  autocomplete="email"
                  required
                >
                <button type="submit" class="password-page__newsletter-submit">
                  {{ section.settings.newsletter_button }}
                </button>
                {%- if form.errors -%}
                  <p class="password-page__error">{{ form.errors | default_errors }}</p>
                {%- endif -%}
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}

        {%- if section.settings.footer_text != blank -%}
          <div class="password-page__footer">{{ section.settings.footer_text }}</div>
        {%- endif -%}
      </div>
    </div>

    {%- if has_image -%}
      <div class="password-page__media">
        {{ image | image_url: width: 1600 | image_tag:
            loading: 'eager',
            sizes: '(min-width: 860px) 50vw, 100vw',
            widths: '640, 960, 1280, 1600, 2000',
            class: 'password-page__img',
            alt: ''
        }}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .password-page {
    background: var(--bg);
    color: var(--text);
    width: 100%;
    min-height: 100svh;
    display: flex;
    align-items: stretch;
  }

  .password-page__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    width: 100%;
  }
  .password-page--image-left .password-page__copy  { order: 2; }
  .password-page--image-left .password-page__media { order: 1; }

  .password-page--no-image .password-page__split {
    grid-template-columns: 1fr;
    place-items: center;
  }

  .password-page__copy {
    padding: clamp(40px, 7vw, 96px) clamp(24px, 5vw, 72px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .password-page--no-image .password-page__copy {
    text-align: center;
    max-width: 640px;
    width: 100%;
    margin-inline: auto;
  }

  .password-page__inner {
    max-width: 480px;
    width: 100%;
  }
  .password-page--no-image .password-page__inner {
    margin-inline: auto;
  }

  /* Logo / wordmark */
  .password-page__logo {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .password-page__logo-img {
    height: 44px;
    width: auto;
  }
  .password-page__wordmark {
    font-size: clamp(1.1rem, 1.4vw, 1.4rem);
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .password-page--no-image .password-page__logo,
  .password-page--no-image .password-page__wordmark {
    margin-inline: auto;
  }

  /* Eyebrow */
  .password-page__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .password-page__eyebrow::before {
    content: "";
    width: 26px;
    height: 0;
    border-top: 1.5px solid currentColor;
    opacity: 0.8;
  }

  /* Heading */
  .password-page__heading {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1.6rem + 2vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .password-page__heading > h1,
  .password-page__heading > p {
    margin: 0;
    max-width: none;
    font: inherit;
    color: inherit;
  }
  .password-page__heading em {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--accent);
    font-weight: 400;
  }

  /* Body */
  .password-page__body {
    margin-top: 20px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-soft);
    max-width: 42ch;
  }
  .password-page--no-image .password-page__body {
    margin-inline: auto;
  }
  .password-page__body > p {
    margin: 0 0 0.6em;
    max-width: none;
  }
  .password-page__body > p:last-child { margin-bottom: 0; }

  /* Password form */
  .password-page__form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(28px, 4vw, 40px);
  }
  .password-page__input {
    flex: 1 1 220px;
    padding: 13px 16px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 15px;
    transition: border-color var(--dur) var(--ease);
  }
  .password-page__input::placeholder { color: var(--text-mute); }
  .password-page__input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .password-page__submit {
    padding: 13px 24px;
    background: var(--accent);
    color: var(--accent-text);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--dur) var(--ease);
  }
  .password-page__submit:hover { background: var(--hcw-red-deep); }

  .password-page__error {
    flex-basis: 100%;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--accent);
  }

  /* Divider */
  .password-page__divider {
    margin: clamp(32px, 5vw, 48px) 0 clamp(20px, 3vw, 28px);
    height: 0;
    border-top: 1px solid var(--line);
  }

  /* Newsletter (notify-me) */
  .password-page__newsletter-heading {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-soft);
    margin-bottom: 14px;
  }
  .password-page__newsletter-form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .password-page__newsletter-input {
    flex: 1 1 220px;
    padding: 12px 16px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 14px;
    transition: border-color var(--dur) var(--ease);
  }
  .password-page__newsletter-input::placeholder { color: var(--text-mute); }
  .password-page__newsletter-input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .password-page__newsletter-submit {
    padding: 12px 20px;
    background: transparent;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1.5px solid var(--text);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .password-page__newsletter-submit:hover {
    background: var(--text);
    color: var(--bg);
  }
  .password-page__newsletter-success {
    margin: 0;
    padding: 14px 18px;
    background: var(--surface);
    border-left: 3px solid var(--accent);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-0);
    color: var(--text);
  }

  /* Footer line (e.g., social handle) */
  .password-page__footer {
    margin-top: clamp(28px, 4vw, 40px);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--text-mute);
    letter-spacing: 0.04em;
  }
  .password-page__footer a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .password-page__footer a:hover { color: var(--accent); }

  /* Media */
  .password-page__media {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
  }
  .password-page__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Accessibility helper (scoped) */
  .password-page .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 860px) {
    .password-page {
      min-height: auto;
    }
    .password-page__split,
    .password-page--image-left .password-page__split {
      grid-template-columns: 1fr;
    }
    .password-page__split .password-page__media {
      order: 1;
      min-height: 280px;
    }
    .password-page__split .password-page__copy {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to the shop name as a wordmark."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Opening soon"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap a word in <em>…</em> for an italic Lora accent.",
      "default": "<p>We're stitching the <em>finishing</em> touches</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>The shop opens to the public soon. Have the password? Slip in below.</p>"
    },
    {
      "type": "header",
      "content": "Password form"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Password placeholder",
      "default": "Password"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enter"
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shown beside the password form. Leave blank for a centered layout on the color scheme background."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Notify-me form"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show notify-me signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Be the first to know when we open"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email field placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Button label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "newsletter_tag",
      "label": "Customer tag",
      "info": "Added alongside \"newsletter\" so you can target launch announcements.",
      "default": "launch-list"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Success message",
      "default": "Thank you — we'll be in touch when the doors open."
    },
    {
      "type": "header",
      "content": "Footer line"
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer text",
      "info": "Optional. Good for a social handle or short tagline.",
      "default": "<p>Follow along at <a href=\"https://instagram.com\">@highcountrywomen</a></p>"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "cream"
    }
  ]
}
{% endschema %}
