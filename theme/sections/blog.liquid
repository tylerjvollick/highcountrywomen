<section class="blog-page color-{{ section.settings.color_scheme }} full-width">
  <div class="blog-page__wrap">
    <header class="blog-page__header">
      <span class="blog-page__eyebrow">Journal</span>
      <h1 class="blog-page__heading">{{ blog.title }}</h1>
    </header>

    {%- paginate blog.articles by 9 -%}
      {%- if blog.articles_count > 0 -%}
        <div class="blog-page__grid">
          {%- for article in blog.articles -%}
            <article class="journal-card">
              <a class="journal-card__media" href="{{ article.url }}" aria-label="{{ article.title }}">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 900 | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 860px) 33vw, 100vw',
                      widths: '450, 600, 900, 1200',
                      class: 'journal-card__img'
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'journal-card__img journal-card__img--placeholder' }}
                {%- endif -%}
              </a>

              <div class="journal-card__body">
                {%- if article.tags.size > 0 -%}
                  <span class="journal-card__tag">{{ article.tags | first }}</span>
                {%- endif -%}

                <h2 class="journal-card__title">
                  <a href="{{ article.url }}">{{ article.title }}</a>
                </h2>

                <div class="journal-card__meta">
                  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%b %e, %Y' }}</time>
                  {%- if article.author != blank -%}
                    <span class="journal-card__meta-sep">·</span>
                    <span>{{ article.author }}</span>
                  {%- endif -%}
                </div>

                {%- if article.excerpt != blank or article.content != blank -%}
                  <p class="journal-card__excerpt">{{ article.excerpt | default: article.content | strip_html | truncatewords: 28 }}</p>
                {%- endif -%}

                <a class="journal-card__cta" href="{{ article.url }}">
                  Read article
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14"/>
                    <path d="m12 5 7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </article>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="blog-page__pagination" aria-label="Pagination">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="blog-page__empty">No journal entries yet — check back soon.</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% stylesheet %}
  .blog-page {
    background: var(--bg);
    color: var(--text);
    width: 100%;
  }
  .blog-page__wrap {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: clamp(40px, 6vw, 80px) var(--page-margin) clamp(56px, 8vw, 112px);
  }

  .blog-page__header {
    text-align: center;
    margin-bottom: clamp(36px, 5vw, 60px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .blog-page__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .blog-page__eyebrow::before {
    content: "";
    width: 26px;
    height: 0;
    border-top: 1.5px solid currentColor;
    opacity: 0.8;
  }
  .blog-page__heading {
    margin: 0;
    font-size: clamp(2.4rem, 1.8rem + 2.6vw, 3.6rem);
  }

  .blog-page__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 3vw, 40px) clamp(20px, 2.5vw, 32px);
  }
  @media (max-width: 860px) {
    .blog-page__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Journal card */
  .journal-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .journal-card__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .journal-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .journal-card__media:hover .journal-card__img {
    transform: scale(1.04);
  }
  .journal-card__img--placeholder {
    opacity: 0.5;
  }

  .journal-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .journal-card__tag {
    align-self: flex-start;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .journal-card__title {
    margin: 0;
    font-size: var(--step-2);
    line-height: 1.15;
  }
  .journal-card__title a {
    color: inherit;
    text-decoration: none;
  }
  .journal-card__title a:hover {
    color: var(--accent);
  }
  .journal-card__meta {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-mute);
  }
  .journal-card__meta-sep {
    margin: 0 6px;
    opacity: 0.6;
  }
  .journal-card__excerpt {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-soft);
  }
  .journal-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    align-self: flex-start;
    margin-top: 4px;
  }
  .journal-card__cta svg {
    width: 14px;
    height: 14px;
    transition: transform var(--dur) var(--ease);
  }
  .journal-card__cta:hover svg {
    transform: translateX(3px);
  }

  .blog-page__empty {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--text-mute);
    text-align: center;
    padding: 60px 0;
  }

  .blog-page__pagination {
    margin-top: clamp(36px, 5vw, 60px);
    display: flex;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 14px;
  }
  .blog-page__pagination .pagination {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .blog-page__pagination a,
  .blog-page__pagination .page.current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 10px;
    color: var(--text-soft);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .blog-page__pagination a:hover {
    color: var(--accent);
    background: var(--surface);
  }
  .blog-page__pagination .page.current {
    color: var(--accent-text);
    background: var(--accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "cream"
    }
  ],
  "enabled_on": {
    "templates": ["blog"]
  }
}
{% endschema %}
