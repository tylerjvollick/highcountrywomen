{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  if heading == blank
    assign heading = collection.title
  endif
  assign blurb = section.settings.blurb
  if blurb == blank and section.settings.use_collection_description
    assign blurb = collection.description
  endif
-%}

<section class="collection-banner color-{{ section.settings.color_scheme }} full-width">
  <div class="collection-banner__wrap">
    {%- if eyebrow != blank -%}
      <span class="collection-banner__eyebrow">{{ eyebrow }}</span>
    {%- endif -%}

    {%- if heading != blank -%}
      <h1 class="collection-banner__heading">{{ heading }}</h1>
    {%- endif -%}

    {%- if blurb != blank -%}
      <div class="collection-banner__blurb">{{ blurb }}</div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .collection-banner {
    background: var(--bg);
    color: var(--text);
    width: 100%;
  }

  .collection-banner__wrap {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: clamp(36px, 5vw, 64px) var(--page-margin) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .collection-banner__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .collection-banner__eyebrow::before {
    content: "";
    width: 26px;
    height: 0;
    border-top: 1.5px solid currentColor;
    opacity: 0.8;
  }

  .collection-banner__heading {
    margin: 18px 0 0;
    font-size: clamp(2.8rem, 2rem + 4vw, 5.2rem);
    line-height: 1.02;
  }

  .collection-banner__blurb {
    margin-top: 18px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-soft);
    max-width: 48ch;
  }
  .collection-banner__blurb > p {
    margin: 0 0 0.5em;
    max-width: none;
  }
  .collection-banner__blurb > p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Pattern Library"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "When blank, uses the collection title."
    },
    {
      "type": "richtext",
      "id": "blurb",
      "label": "Blurb override"
    },
    {
      "type": "checkbox",
      "id": "use_collection_description",
      "label": "Use collection description as blurb when override is blank",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "cream"
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}
